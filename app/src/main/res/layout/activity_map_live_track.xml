<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarSpace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= TOP BAR ================= -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpace">
        <!-- Back -->

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back_arrow" />

        <!-- Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTrackName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cedar Ridge Hollow"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"/>

            <TextView
                android:id="@+id/tvTrackLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Madison County, GA"
                android:textColor="@color/textview_gray"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"/>
        </LinearLayout>

    </RelativeLayout>


    <!-- ================= MAP ================= -->
    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================= RIGHT MAP TOOLS ================= -->
    <LinearLayout
        android:id="@+id/layoutMapTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/layoutInfoCards">

        <!-- Zoom In -->
        <RelativeLayout
            android:id="@+id/rlZoomIn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_background_shadow"
            android:elevation="4dp"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_plus" />
        </RelativeLayout>

        <!-- Zoom Out -->
        <RelativeLayout
            android:id="@+id/rlZoomOut"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_background_shadow"
            android:elevation="4dp"
            android:layout_marginTop="10dp"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_minus" />
        </RelativeLayout>

        <!-- Location -->
        <RelativeLayout
            android:id="@+id/rlCurrentLocation"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_background_shadow"
            android:elevation="4dp"
            android:layout_marginTop="10dp"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_loc" />
        </RelativeLayout>

        <!-- Layer -->
        <RelativeLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_background_shadow"
            android:elevation="4dp"
            android:layout_marginTop="10dp"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_layer" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlDirection"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_background_shadow"
            android:elevation="4dp"
            android:layout_marginTop="10dp"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_direction" />
        </RelativeLayout>

    </LinearLayout>


    <!-- ================= INFO CARDS ================= -->

    <LinearLayout
        android:id="@+id/layoutInfoCards"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginHorizontal="14dp"
        android:orientation="horizontal"
        android:weightSum="3"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/bottomTrackingCard">

        <!-- Acres -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_stats_card"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_acress"/>

            <TextView
                android:id="@+id/tvAcres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="480"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="@font/inter_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/acres"
                android:textColor="@color/textview_gray"
                android:textSize="10sp"
                android:fontFamily="@font/inter_regular"/>
        </LinearLayout>

        <!-- Date -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_stats_card"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_clock_pink"/>

            <TextView
                android:id="@+id/tvValidDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Dec 2026"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="@font/inter_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valid"
                android:textColor="@color/textview_gray"
                android:textSize="10sp"
                android:fontFamily="@font/inter_regular"/>

        </LinearLayout>

        <!-- Offline -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stats_card"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical"
           >

            <ImageView
                android:id="@+id/ivNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_offline"/>

            <TextView
                android:id="@+id/tvNetworkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/offline"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="@font/inter_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map"
                android:textColor="@color/textview_gray"
                android:textSize="10sp"
                android:fontFamily="@font/inter_regular"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ================= BOTTOM LIVE TRACKING CARD ================= -->

    <LinearLayout
        android:id="@+id/bottomTrackingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_allsides"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Left -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_clock_"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="@string/time"
                    android:textColor="@color/textview_gray"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvTrackingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:20:05"
                android:textColor="@color/black"
                android:textSize="26sp"
                android:fontFamily="@font/inter_bold"/>

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.5 km"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"/>

        </LinearLayout>

        <!-- STOP BUTTON -->
        <ImageView
            android:id="@+id/btnStop"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_stop"/>

        <!-- PAUSE BUTTON -->
        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_play"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>