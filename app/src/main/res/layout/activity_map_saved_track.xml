<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarSpace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= TOP BAR ================= -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpace">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back_arrow" />

        <!-- Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cedar Ridge Hollow"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"/>

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Madison County, GA"
                android:textColor="@color/textview_gray"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"/>
        </LinearLayout>
    </RelativeLayout>

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"/>

    <!-- BOTTOM CARD -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:background="@drawable/bg_top_round_white"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- DATE -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calender"/>
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="May 20, 2026"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/inter_regular"/>
        </LinearLayout>

        <!-- LOCATION -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="7dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location_new"/>
            <TextView
                android:id="@+id/tvTrackLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cedar Ridge Hollow"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/inter_regular"/>
        </LinearLayout>

        <!-- STATS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp"
            android:weightSum="4">

            <!-- DISTANCE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stats_card">
                <TextView
                    android:id="@+id/tvDistanceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.58km"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/distance"
                    android:textSize="10sp"
                    android:textColor="@color/textview_gray"
                    android:fontFamily="@font/inter_regular"/>
            </LinearLayout>

            <!-- DURATION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stats_card">
                <TextView
                    android:id="@+id/tvDurationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:27"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duration"
                    android:textSize="10sp"
                    android:textColor="@color/textview_gray"
                    android:fontFamily="@font/inter_regular"/>
            </LinearLayout>

            <!-- PACE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stats_card">
                <TextView
                    android:id="@+id/tvPaceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.3/km"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pace"
                    android:textSize="10sp"
                    android:textColor="@color/textview_gray"
                    android:fontFamily="@font/inter_regular"/>
            </LinearLayout>

            <!-- ELV -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stats_card">
                <TextView
                    android:id="@+id/tvElevationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65m"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/elv"
                    android:textSize="10sp"
                    android:textColor="@color/textview_gray"
                    android:fontFamily="@font/inter_regular"/>
            </LinearLayout>

        </LinearLayout>

        <!-- BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="22dp"
            android:weightSum="2">

            <!-- EXPORT -->
            <LinearLayout
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/bg_export_button">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_download"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_png"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_regular"/>
            </LinearLayout>

            <!-- SHARE -->

            <LinearLayout
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/bg_share_button">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_share_white"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_regular"/>
            </LinearLayout>

        </LinearLayout>

        <!-- DELETE -->

        <RelativeLayout
            android:id="@+id/rlDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center">

            <TextView
                android:id="@+id/tvDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_track"
                android:textColor="#FF2D2D"
                android:textSize="13sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/ic_delete"
                android:drawablePadding="5dp"
                android:fontFamily="@font/inter_regular"/>

        </RelativeLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>